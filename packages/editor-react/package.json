  },
  "peerDependencies": {
    "pptx-glimpse": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pptx-glimpse": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
