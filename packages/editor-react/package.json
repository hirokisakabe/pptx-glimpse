{
  "name": "@pptx-glimpse/editor-react",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-only React editor UI for consumer-owned pptx-glimpse sessions.",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
